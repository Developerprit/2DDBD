; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2DDBD"
config/description="A top-down 2D pixel asymmetric horror game. 1 Killer vs 4 Survivors."
config/version="1.0.0"
run/main_scene="res://scenes/boot.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.043, 0.047, 0.055, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://src/autoload/game_config.gd"
EventBus="*res://src/autoload/event_bus.gd"
SaveData="*res://src/autoload/save_data.gd"
Locale="*res://src/autoload/locale.gd"
AudioDirector="*res://src/autoload/audio_director.gd"
NetBridge="*res://src/autoload/net_bridge.gd"
SceneRouter="*res://src/autoload/scene_router.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

